# Postgres
POSTGRES_DB=geoscan_planner
POSTGRES_USER=geoscan
POSTGRES_PASSWORD=geoscan

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis
REDIS_URL=redis://redis:6379/0

# LLM (Qwen через OpenAI-совместимый API)
LLM_API_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.7-plus

# Внутренний токен MCP → backend
INTERNAL_API_TOKEN=geoscan-internal-mcp-token
